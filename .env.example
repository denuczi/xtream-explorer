VITE_API_URL=/api
PORT=3001
# Development escape hatch to allow private/loopback hosts (disabled by default).
ALLOW_PRIVATE_HOSTS=0
# Development escape hatch for panels with broken TLS certificate chains (disabled by default).
ALLOW_INSECURE_TLS=0
# User-Agent sent to the Xtream panel on every request (API + streams + M3U files).
XTREAM_USER_AGENT=SparkleTV/2.3.1 (ATV R2, Android 9)
